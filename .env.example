# Copy this file to .env and fill in your real values.
# .env is gitignored and must never be committed.

# Required. Google AI Studio API key, used for both embeddings and generation.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional. All of these have working defaults in src/pipeline/config.py —
# override them here to experiment without touching code.
# EMBEDDING_MODEL=models/gemini-embedding-001
# GENERATION_MODEL=gemini-3.5-flash
# COLLECTION_NAME=gemini_collection
# PERSIST_DIRECTORY=./chroma_gemini_db
# CHUNK_SIZE=1000
# RETRIEVAL_K=3
